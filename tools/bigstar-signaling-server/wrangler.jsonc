{
  "name": "bigstar-signaling-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_ROOM",
        "class_name": "SignalingRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "LobbyObject"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "LOG_ARCHIVES",
      "bucket_name": "bigstar-log-archives-test"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingRoom", "LobbyObject"]
    }
  ],
  "vars": {
    "CORS_ORIGINS": "http://127.0.0.1:1420,http://localhost:1420",
    "DEFAULT_ICE_SERVERS": "stun:stun.l.google.com:19302",
    "LOG_UPLOAD_TOKEN": "test-upload-token"
  }
}
