{
  "name": "nsmb-mvl-gui",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "prepare": "panda codegen",
    "build": "node scripts/build-tauri.mjs",
    "sync:sidecars": "node scripts/sync-sidecars.mjs",
    "panda:codegen": "panda codegen",
    "typecheck": "tsc --noEmit",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "test:unit": "vitest --config vitest.config.ts run",
    "test:browser": "vitest --config vitest.browser.config.ts run",
    "test:e2e": "playwright test",
    "ci": "tsc --noEmit && biome check . && vitest --config vitest.config.ts run && vitest --config vitest.browser.config.ts run && playwright test",
    "vite:build": "vite build",
    "vite:dev": "vite --host 127.0.0.1",
    "preview:browser": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@cloudflare/workers-types": "^4.20260605.1",
    "@pandacss/dev": "^1.11.1",
    "@park-ui/panda-preset": "^0.43.1",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.1.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "vitest-browser-react": "^2.2.0"
  },
  "packageManager": "pnpm@10.26.2"
}
