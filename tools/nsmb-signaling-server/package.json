{
  "name": "nsmb-signaling-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.26.2"
  },
  "scripts": {
    "dev": "alchemy dev --app nsmb-mvl-signaling",
    "deploy": "alchemy deploy --app nsmb-mvl-signaling",
    "destroy": "alchemy destroy --app nsmb-mvl-signaling",
    "typecheck": "tsc --noEmit",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "ci": "tsc --noEmit && biome check ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "alchemy": "0.90.1",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@cloudflare/workers-types": "^4.20260124.0",
    "@types/node": "^20",
    "typescript": "^5.9.3",
    "wrangler": "^4.60.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
